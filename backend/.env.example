# Copy this file to .env and fill in your values

MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0
DATABASE_NAME=dealhunter
SCRAPER_CRON_INTERVAL_MINUTES=360

# Your deployed frontend URL — prevents wildcard CORS in production
# Example: https://yourapp.vercel.app
FRONTEND_URL=

# SMTP email for price drop alert notifications
# Works with any SMTP provider (Gmail, Brevo, SendGrid, etc.)

# --- Option A: Gmail ---
# Use an App Password (https://myaccount.google.com/apppasswords)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

# --- Option B: Brevo (Sendinblue) ---
# Get credentials from: https://app.brevo.com/settings/keys/smtp
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587

EMAIL_USER=your_email@domain.com
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=your_email@domain.com
